{
  NSExecutable = "WinUITheme.dll";
  NSPrincipalClass = "WinUITheme";
  GSThemeAuthors = (
    "Daniel Boyd"
  );
  GSThemeDetails = "WinUI 3-inspired GNUstep theme";
  GSThemeImages = {
    common_SliderHoriz = "SliderThumb.png";
    common_SliderVert = "SliderThumb.png";
  };
  GSThemeVersion = "0.1.0-alpha1";
  /* Panels whose class adopts GSThemePopoverPanel are drawn as WinUI
     flyouts; apps leave their background to the theme. */
  GSThemeDrawsPopoverPanels = YES;
  GSThemeDomain = {
    GSBackHandlesWindowDecorations = YES;
    NSInterfaceStyleDefault = NSWindows95InterfaceStyle;
    NSMenuInterfaceStyle = NSWindows95InterfaceStyle;
    NSScrollViewInterfaceStyle = NSWindows95InterfaceStyle;
    NSScrollerInterfaceStyle = NSWindows95InterfaceStyle;
    GSScrollerButtonsOffset = 0;
    GSScrollerArrowsSameEnd = NO;
  };
}
